#--------------------------------------------------------------------------
# Delta Initiatives — environment template
# Copy to .env and fill in. Values marked TEAM/SECRET must come from the team.
#--------------------------------------------------------------------------
APP_NAME="Delta Initiatives"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_DISPLAY_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL / MariaDB (Hostinger: hPanel → Databases → MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delta_initiatives
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only cookies)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "database" + the scheduler cron in production; "sync" also works.
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mail — Google Workspace SMTP (production). Use an App Password for the sending
# mailbox (Google Account → Security → App passwords) and add SPF + DKIM in Cloudflare DNS.
# Locally, "log" writes e-mails to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ideas@deltainitiatives.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ideas@deltainitiatives.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile — defaults are Cloudflare's always-pass TEST keys.
# SECRET: create a widget for deltainitiatives.com in Cloudflare → Turnstile.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Security & SEO
CSP_ENABLED=true
SEO_NOINDEX=false
TRUSTED_PROXIES=*
FORM_MIN_SECONDS=3

# Show the small "Sample" badge on seeded demo content.
SHOW_DEMO_BADGES=true

# First Super Admin created by the seeder (password printed once if left empty).
ADMIN_NAME="Delta Admin"
ADMIN_EMAIL=admin@deltainitiatives.com
ADMIN_PASSWORD=

# Backups (storage/app/private/backups). Optional path to mysqldump for faster dumps.
BACKUP_KEEP=14
BACKUP_MYSQLDUMP_PATH=

VITE_APP_NAME="${APP_NAME}"
